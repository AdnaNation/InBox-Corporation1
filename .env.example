# Public application URL used to build OAuth callback URLs
NEXT_PUBLIC_APP_URL=https://inbox-corporation-new.vercel.app

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login (Meta for Developers)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Paddle Billing — checkout stays disabled until all six price IDs,
# a client-side token, and the webhook destination secret are configured.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_YEARLY=
PADDLE_PRICE_GROWTH_MONTHLY=
PADDLE_PRICE_GROWTH_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=
