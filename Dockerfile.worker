FROM node:22-alpine

ENV NODE_ENV=production npm_config_cache=/tmp/.npm
WORKDIR /app

# The polling worker uses only Node.js built-ins; it does not need the Next.js
# application bundle or the full node_modules tree.
COPY --chown=node:node package.json ./package.json
COPY --chown=node:node scripts/background-worker.mjs ./scripts/background-worker.mjs
COPY --chown=node:node src/lib/background-worker-core.mjs ./src/lib/background-worker-core.mjs

USER node
CMD ["npm", "run", "worker"]
