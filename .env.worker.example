# Public HTTPS origin of the deployed Wavo application (no trailing slash).
WAVO_APP_URL=https://your-wavo-domain.com

# Use the exact same 32+ character value configured as CRON_SECRET in Vercel.
CRON_SECRET=replace-with-a-random-64-character-hex-secret

# Optional worker tuning.
WORKER_INTERVAL_MS=5000
WORKER_REQUEST_TIMEOUT_MS=45000
